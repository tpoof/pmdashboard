<script>
  $(document).ready(function () {
    $(document).on("change", "#3", function () {
      var newTitle = $(this).val().trim();

      if (newTitle === "") {
        return;
      }

      var resolvedRecordID = (typeof recordID !== "undefined") ? recordID : null;
      var resolvedToken = (typeof CSRFToken !== "undefined")
        ? CSRFToken
        : $('input[name="CSRFToken"]').val();

      if (!resolvedRecordID || !resolvedToken) {
        console.error("Unable to update title: missing recordID or CSRFToken.");
        return;
      }

      $.ajax({
        type: "POST",
        url: "./api/form/" + resolvedRecordID + "/title",
        data: {
          title: newTitle,
          CSRFToken: resolvedToken,
        },
        success: function (res) {
          var updatedTitle = (typeof res === "string" && res.trim() !== "") ? res : newTitle;
          $("#requestTitle").text(updatedTitle);
          $("#title").val(updatedTitle);
        },
        error: function (xhr, status, err) {
          console.error("Failed to update title:", status, err, xhr.responseText);
        }
      });
    });
  });
</script>