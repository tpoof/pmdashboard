<script>
$(document).ready(function() {
    // Any time indicator 9's value changes, update the title immediately
    $('#9').on('change', function() {
        var newTitle = $(this).val().trim();
        if (newTitle !== '') {
            $.ajax({
                type: 'POST',
                url: './api/form/{{ recordID }}/title',
                data: {
                    title: newTitle,
                    CSRFToken: CSRFToken
                }
            });
        }
    });
});
</script>