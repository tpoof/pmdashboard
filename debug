<script>
$(function() {
    if (window.location.href.indexOf('printview') === -1 &&
        window.location.href.indexOf('a=print') === -1) {
        // Hide and disable entire field wrapper
        $('.response.blockIndicator_45').hide();
        
        // Disable iCheck's visual overlay span — this is the actual click target
        $('.response.blockIndicator_45 span.leaf_check').css('pointer-events', 'none');
        
        // Disable the input and label
        $('#45_').attr('disabled', true);
        $('label[for="45_"]').css('pointer-events', 'none');
        
        // Disable via iCheck API if initialized
        if ($.fn.iCheck) {
            $('.icheck45').iCheck('disable');
        }
    }
});
</script>