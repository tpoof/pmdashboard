(async function testOldFilter() {
  var q = new LeafFormQuery();
  q.addTerm("recordID", "=", "278");
  q.addTerm("stepID", "!=", "notSubmitted");
  var r = await q.execute();
  console.log("TASK 278 WITH OLD stepID!=notSubmitted filter:", r);
  console.log("Is empty?", !r || Object.keys(r).length === 0);
})();


