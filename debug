<script>
$(function() {
    // Hide the input itself
    $('#{{ iID }}').hide();
    
    // Hide the sublabel
    $('.sublabel.blockIndicator_{{ iID }}').hide();
    
    // Hide the parent container (catches the visible checkbox widget)
    $('#{{ iID }}').closest('tr').hide();
    
    // Disable it so it can't be interacted with
    $('#{{ iID }}').attr('disabled', true);
});
</script>

$('#{{ iID }}').closest('.xtemplate_field').hide(); // try this first
$('#{{ iID }}').closest('tr').hide();               // fallback
$('#{{ iID }}').closest('div').hide();              // last resort