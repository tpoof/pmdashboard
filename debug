// Check main document
console.log('main doc:', document.querySelectorAll('.sublabel.blockIndicator_45').length);

// Check all iframes
document.querySelectorAll('iframe').forEach(function(frame, i) {
    try {
        var doc = frame.contentDocument || frame.contentWindow.document;
        console.log('iframe ' + i, frame.id, {
            sublabel: doc.querySelectorAll('.sublabel.blockIndicator_45').length,
            response: doc.querySelectorAll('.response.blockIndicator_45').length
        });
    } catch(e) {
        console.log('iframe ' + i, 'cross-origin blocked');
    }
});