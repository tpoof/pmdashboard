<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>LEAF Bulk Title Updater</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap');

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0f1117;
            --surface: #181c27;
            --border: #2a2f3d;
            --accent: #4f9cf9;
            --accent2: #f97b4f;
            --green: #3ecf8e;
            --red: #f95f5f;
            --yellow: #f9c84f;
            --text: #e2e8f0;
            --muted: #6b7694;
            --mono: 'IBM Plex Mono', monospace;
            --sans: 'IBM Plex Sans', sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--sans);
            min-height: 100vh;
            padding: 32px 24px;
        }

        header {
            border-left: 3px solid var(--accent);
            padding-left: 16px;
            margin-bottom: 32px;
        }

        header h1 {
            font-family: var(--mono);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--accent);
            letter-spacing: -0.02em;
        }

        header p {
            font-size: 0.85rem;
            color: var(--muted);
            margin-top: 4px;
        }

        .config-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 24px;
        }

        .config-grid.full { grid-template-columns: 1fr; }

        label {
            display: block;
            font-size: 0.75rem;
            font-family: var(--mono);
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 6px;
        }

        input[type="text"] {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text);
            font-family: var(--mono);
            font-size: 0.85rem;
            padding: 9px 12px;
            border-radius: 4px;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus { border-color: var(--accent); }

        .jobs-section {
            margin-bottom: 24px;
        }

        .jobs-label {
            font-size: 0.75rem;
            font-family: var(--mono);
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 10px;
        }

        .job-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 14px 16px;
            margin-bottom: 10px;
            display: grid;
            grid-template-columns: auto 1fr 1fr auto;
            gap: 12px;
            align-items: center;
        }

        .job-card .job-num {
            font-family: var(--mono);
            font-size: 0.75rem;
            color: var(--accent);
            background: rgba(79,156,249,0.1);
            border-radius: 3px;
            padding: 2px 7px;
            white-space: nowrap;
        }

        .job-card input[type="text"] {
            font-size: 0.8rem;
            padding: 7px 10px;
        }

        .job-card .remove-btn {
            background: none;
            border: 1px solid var(--border);
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.8rem;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
        }

        .job-card .remove-btn:hover { border-color: var(--red); color: var(--red); }

        .job-header-row {
            display: grid;
            grid-template-columns: auto 1fr 1fr auto;
            gap: 12px;
            margin-bottom: 4px;
            padding: 0 0 0 2px;
        }

        .job-header-row span {
            font-size: 0.7rem;
            font-family: var(--mono);
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .add-job-btn {
            background: none;
            border: 1px dashed var(--border);
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.8rem;
            padding: 8px 14px;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            transition: all 0.15s;
            margin-top: 4px;
        }

        .add-job-btn:hover { border-color: var(--accent); color: var(--accent); }

        .controls {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .btn-run {
            background: var(--accent);
            color: #fff;
            border: none;
            font-family: var(--mono);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 4px;
            cursor: pointer;
            transition: opacity 0.15s;
        }

        .btn-run:hover { opacity: 0.85; }
        .btn-run:disabled { opacity: 0.4; cursor: not-allowed; }

        .btn-stop {
            background: none;
            border: 1px solid var(--red);
            color: var(--red);
            font-family: var(--mono);
            font-size: 0.85rem;
            padding: 10px 20px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-stop:hover { background: rgba(249,95,95,0.1); }

        #status-bar {
            font-family: var(--mono);
            font-size: 0.8rem;
            color: var(--muted);
            padding: 8px 0;
            min-height: 28px;
        }

        #status-bar.running { color: var(--accent); }
        #status-bar.done { color: var(--green); }

        .progress-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 3px;
            height: 4px;
            margin-bottom: 16px;
            overflow: hidden;
        }

        #progress-bar {
            height: 100%;
            width: 0%;
            background: var(--accent);
            transition: width 0.3s ease;
            border-radius: 3px;
        }

        .log-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
        }

        .log-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,0.02);
        }

        .log-toolbar span {
            font-family: var(--mono);
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .log-clear {
            background: none;
            border: none;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.72rem;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            transition: color 0.15s;
        }

        .log-clear:hover { color: var(--text); }

        #log {
            height: 320px;
            overflow-y: auto;
            padding: 12px 14px;
            font-family: var(--mono);
            font-size: 0.78rem;
            line-height: 1.7;
        }

        #log::-webkit-scrollbar { width: 6px; }
        #log::-webkit-scrollbar-track { background: transparent; }
        #log::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        .log-success { color: var(--green); }
        .log-error   { color: var(--red); }
        .log-skip    { color: var(--muted); }
        .log-info    { color: var(--accent); }
        .log-job     { color: var(--yellow); border-top: 1px solid var(--border); padding-top: 8px; margin-top: 4px; }
        .log-done    { color: var(--green); border-top: 1px solid var(--border); padding-top: 8px; margin-top: 4px; font-weight: 600; }

        .stat-row {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .stat {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 16px;
            text-align: center;
            min-width: 80px;
        }

        .stat-num {
            font-family: var(--mono);
            font-size: 1.3rem;
            font-weight: 600;
        }

        .stat-num.green { color: var(--green); }
        .stat-num.red   { color: var(--red); }
        .stat-num.gray  { color: var(--muted); }

        .stat-label {
            font-size: 0.68rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-top: 2px;
        }

        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 24px 0;
        }
    </style>
</head>
<body>

<header>
    <h1>LEAF // Bulk Title Updater</h1>
    <p>Sets request titles from indicator field values across one or more form types</p>
</header>

<div class="config-grid">
    <div>
        <label>Base URL</label>
        <input type="text" id="baseURL" placeholder="https://your-leaf-site/path/to/portal/" />
    </div>
    <div>
        <label>CSRFToken <span style="font-size:0.7rem;color:var(--muted)">(type CSRFToken in browser console)</span></label>
        <input type="text" id="csrfToken" placeholder="Paste your CSRFToken here" />
    </div>
</div>

<hr class="divider" />

<div class="jobs-section">
    <div class="jobs-label">Update Jobs</div>
    <div class="job-header-row">
        <span style="width:60px"></span>
        <span>Category ID <span style="color:#3a3f52">(leave blank = all forms)</span></span>
        <span>Indicator ID to use as title</span>
        <span style="width:60px"></span>
    </div>
    <div id="jobs-container"></div>
    <button class="add-job-btn" onclick="addJob()">+ Add another job</button>
</div>

<hr class="divider" />

<div class="controls">
    <button class="btn-run" id="btn-run" onclick="startUpdate()">▶ Run All Jobs</button>
    <button class="btn-stop" onclick="stopUpdate()">■ Stop</button>
</div>

<div id="status-bar">Ready.</div>
<div class="progress-wrap"><div id="progress-bar"></div></div>

<div class="stat-row">
    <div class="stat"><div class="stat-num green" id="stat-updated">0</div><div class="stat-label">Updated</div></div>
    <div class="stat"><div class="stat-num gray"  id="stat-skipped">0</div><div class="stat-label">Skipped</div></div>
    <div class="stat"><div class="stat-num red"   id="stat-errors">0</div><div class="stat-label">Errors</div></div>
</div>

<div class="log-wrap">
    <div class="log-toolbar">
        <span>Output Log</span>
        <button class="log-clear" onclick="$('#log').empty()">Clear</button>
    </div>
    <div id="log"></div>
</div>

<script>
    var shouldStop = false;
    var jobCount = 0;

    // Pre-populate the two known jobs
    function addJob(categoryID, indicatorID) {
        jobCount++;
        var num = jobCount;
        var catVal = categoryID || '';
        var indVal = indicatorID || '';
        var html = `
            <div class="job-card" id="job-${num}">
                <span class="job-num">JOB ${num}</span>
                <input type="text" placeholder="e.g. form_55445  (blank = all)" value="${catVal}" class="job-category" />
                <input type="text" placeholder="e.g. 9" value="${indVal}" class="job-indicator" />
                <button class="remove-btn" onclick="removeJob(${num})">Remove</button>
            </div>`;
        $('#jobs-container').append(html);
    }

    function removeJob(num) {
        $('#job-' + num).remove();
    }

    function log(msg, cls) {
        $('#log').append(`<div class="${cls||''}">${msg}</div>`);
        var el = document.getElementById('log');
        el.scrollTop = el.scrollHeight;
    }

    function setStats(u, s, e) {
        $('#stat-updated').text(u);
        $('#stat-skipped').text(s);
        $('#stat-errors').text(e);
    }

    function stopUpdate() {
        shouldStop = true;
        log('⬛ Stop requested — will halt after current record.', 'log-error');
    }

    async function startUpdate() {
        shouldStop = false;
        $('#log').empty();
        setStats(0, 0, 0);
        $('#progress-bar').css('width', '0%');

        var baseURL = $('#baseURL').val().trim().replace(/\/$/, '') + '/';
        var CSRFToken = $('#csrfToken').val().trim();

        if (!baseURL || !CSRFToken) {
            alert('Please enter both Base URL and CSRFToken.');
            return;
        }

        // Collect jobs
        var jobs = [];
        $('#jobs-container .job-card').each(function() {
            var cat = $(this).find('.job-category').val().trim();
            var ind = $(this).find('.job-indicator').val().trim();
            if (ind !== '') {
                jobs.push({ categoryID: cat, indicatorID: ind });
            }
        });

        if (jobs.length === 0) {
            alert('Please add at least one job with an Indicator ID.');
            return;
        }

        $('#btn-run').prop('disabled', true);
        $('#status-bar').attr('class', 'running').text('Starting...');

        var totalUpdated = 0, totalSkipped = 0, totalErrors = 0;

        for (var j = 0; j < jobs.length; j++) {
            if (shouldStop) break;

            var job = jobs[j];
            var jobLabel = job.categoryID
                ? `Category: ${job.categoryID} → Indicator: ${job.indicatorID}`
                : `All Forms → Indicator: ${job.indicatorID}`;

            log(`▶ JOB ${j+1}: ${jobLabel}`, 'log-job');

            // Build query — filter by categoryID if specified
            var terms = [{ id: 'deleted', operator: '=', match: '0' }];
            if (job.categoryID !== '') {
                terms.push({ id: 'categoryID', operator: '=', match: job.categoryID, gate: 'AND' });
            }
            var query = { terms: terms };

            var records;
            try {
                records = await $.ajax({
                    type: 'GET',
                    url: baseURL + 'api/form/query',
                    data: { q: JSON.stringify(query), 'x-filterData': 'recordID' },
                    dataType: 'json'
                });
            } catch(e) {
                log(`✖ ERROR fetching records for job ${j+1}: ${e.statusText}`, 'log-error');
                totalErrors++;
                continue;
            }

            var recordIDs = Object.keys(records);
            log(`  Found ${recordIDs.length} records.`, 'log-info');

            var updated = 0, skipped = 0, errors = 0;

            for (var i = 0; i < recordIDs.length; i++) {
                if (shouldStop) break;

                var recordID = recordIDs[i];
                var progress = Math.round(((i + 1) / recordIDs.length) * 100);
                $('#progress-bar').css('width', progress + '%');
                $('#status-bar').text(`Job ${j+1}/${jobs.length} — Record ${i+1}/${recordIDs.length} (#${recordID})`);

                try {
                    var data = await $.ajax({
                        type: 'GET',
                        url: baseURL + 'api/form/' + recordID + '/data',
                        dataType: 'json'
                    });

                    // Find the target indicatorID in the response
                    var titleValue = null;
                    $.each(data, function(key, indicator) {
                        var entry = indicator[1] || indicator;
                        if (entry && String(entry.indicatorID) === String(job.indicatorID)) {
                            titleValue = entry.data || null;
                        }
                    });

                    if (!titleValue || titleValue.trim() === '') {
                        log(`  ⚬ #${recordID} — skipped (indicator ${job.indicatorID} empty)`, 'log-skip');
                        skipped++;
                    } else {
                        await $.ajax({
                            type: 'POST',
                            url: baseURL + 'api/form/' + recordID + '/title',
                            data: { title: titleValue.trim(), CSRFToken: CSRFToken }
                        });
                        log(`  ✔ #${recordID} — "${titleValue.trim()}"`, 'log-success');
                        updated++;
                    }

                } catch(e) {
                    log(`  ✖ #${recordID} — ERROR: ${e.statusText || e}`, 'log-error');
                    errors++;
                }

                totalUpdated = (parseInt($('#stat-updated').text()) || 0);
                setStats(totalUpdated + updated - (i > 0 ? updated - 1 : 0), totalSkipped, totalErrors);
                setStats(
                    (parseInt($('#stat-updated').text().replace(/\D/,'')) || 0) + (updated > 0 ? 1 : 0),
                    0, 0
                );

                await new Promise(r => setTimeout(r, 150));
            }

            // Update cumulative stats after each job
            totalUpdated += updated;
            totalSkipped += skipped;
            totalErrors  += errors;
            setStats(totalUpdated, totalSkipped, totalErrors);

            log(`  Job ${j+1} done — Updated: ${updated} | Skipped: ${skipped} | Errors: ${errors}`, 'log-info');
        }

        $('#progress-bar').css('width', '100%');
        $('#btn-run').prop('disabled', false);
        $('#status-bar').attr('class', 'done').text('All jobs complete.');
        log(`━━ DONE ━━  Total Updated: ${totalUpdated} | Skipped: ${totalSkipped} | Errors: ${totalErrors}`, 'log-done');
        setStats(totalUpdated, totalSkipped, totalErrors);
    }

    // Initialize with the two known jobs
    addJob('form_9b302', '9'); // form_9b302 → indicator 9
    addJob('form_55445', '3'); // form_55445 → indicator 3
</script>
</body>
</html>