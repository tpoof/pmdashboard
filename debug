<script>
  (function () {
    var STORAGE_KEY = "leaf_pending_title_sync";
    var STALE_MS = 5 * 60 * 1000; // 5 minutes

    function getRecordID() {
      if (typeof recordID !== "undefined" && recordID) {
        return recordID;
      }
      var val = $('input[name="recordID"]').val();
      return val ? val : null;
    }

    function getCSRFToken() {
      if (typeof CSRFToken !== "undefined" && CSRFToken) {
        return CSRFToken;
      }
      return $('input[name="CSRFToken"]').val();
    }

    function sendTitleUpdate(rid, token, newTitle) {
      $.ajax({
        type: "POST",
        url: "./api/form/" + rid + "/title",
        data: {
          title: newTitle,
          CSRFToken: token,
        },
        success: function (res) {
          var updatedTitle = (typeof res === "string" && res.trim() !== "") ? res : newTitle;
          $("#requestTitle").text(updatedTitle);
          $("#title").val(updatedTitle);
        },
        error: function (xhr, status, err) {
          console.error("Title auto-update failed:", status, err, xhr.responseText);
        }
      });
    }

    $(document).ready(function () {
      // Handle case: page just loaded after a new-record redirect,
      // and there's a pending title waiting to be applied.
      var pending = null;
      try {
        pending = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
      } catch (e) {
        pending = null;
      }

      if (pending && pending.title) {
        var rid = getRecordID();
        var token = getCSRFToken();
        var isFresh = (Date.now() - pending.timestamp) < STALE_MS;

        if (rid && token && isFresh) {
          sendTitleUpdate(rid, token, pending.title);
        }
        // Clear regardless, so it never fires twice or leaks into a later record.
        sessionStorage.removeItem(STORAGE_KEY);
      }

      // Handle indicator #3 changes going forward.
      $(document).on("change", "#3", function () {
        var newTitle = $(this).val().trim();
        if (newTitle === "") {
          return;
        }

        var rid = getRecordID();
        var token = getCSRFToken();

        if (rid && token) {
          // Existing record: update immediately.
          sendTitleUpdate(rid, token, newTitle);
        } else {
          // New/unsaved record: stash for after redirect.
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
            title: newTitle,
            timestamp: Date.now()
          }));
        }
      });
    });
  })();
</script>