// Test the exact draft query being sent
fetch(
  "https://leaf.va.gov/platform/ideas/api/form/query/?x-filterData=recordID,title,created_date,userID&q=" +
    JSON.stringify({
      terms: [
        {
          id: "userID",
          operator: "=",
          match: window.leafIdeaPortal.userID,
          gate: "AND",
        },
        { id: "categoryID", operator: "=", match: "form_ae642", gate: "AND" },
        { id: "deleted", operator: "=", match: 0, gate: "AND" },
        { id: "stepID", operator: "=", match: "notSubmitted", gate: "AND" },
      ],
      joins: [],
      sort: {},
      getData: ["5", "8", "9", "13", "stepID"],
    }),
  { credentials: "same-origin" },
)
  .then((r) => r.text())
  .then(console.log);

