// Scan all script content on the page for orgchart references
Array.from(document.querySelectorAll("script")).forEach(function (s) {
  if (s.textContent.includes("orgchart")) {
    var matches = s.textContent.match(/https?:\/\/[^\s'"]+orgchart[^\s'"]+/gi);
    if (matches) console.log("Found orgchart URLs:", matches);
  }
});

