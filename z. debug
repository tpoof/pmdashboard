fetch('/platform/events/api/form/query?q=' + encodeURIComponent(JSON.stringify({
  terms: [
    { id: 'recordID', operator: '>', match: 0 },
    { id: 'categoryID', operator: '=', match: 'form_84fd4' }
  ],
  joins: ['status'],
  limit: 10
})), { credentials: 'include' })
  .then(r => r.json())
  .then(d => console.table(Object.values(d).map(r => ({ id: r.recordID, status: r.lastStatus }))));