const f = document.getElementById("footer");
const r = f.getBoundingClientRect();
const s = window.getComputedStyle(f);
console.log("height:", r.height);
console.log("padding:", s.padding);
console.log("font-size:", s.fontSize);
console.log("bottom distance:", window.innerHeight - r.bottom);
console.log("background:", s.backgroundColor);
console.log("color:", s.color);
