fetch('/platform/events/api/form/query?q=' + encodeURIComponent(JSON.stringify({
  terms: [
    { id: 'recordID', operator: '>', match: 0 },
    { id: 'categoryID', operator: '=', match: 'form_a5f36' }
  ],
  getData: ['3', '4', '5', '6'],
  joins: ['status'],
  limit: 20
})), { credentials: 'include' })
  .then(r => r.json())
  .then(d => console.table(Object.values(d).map(r => ({
    id: r.recordID,
    status: r.lastStatus,
    name: JSON.stringify(r.s1 && r.s1.id3),
    action: JSON.stringify(r.s1 && r.s1.id6)
  }))));