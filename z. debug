(async () => {
  const q = {
    terms: [
      { id: "125", operator: "!=", match: "", gate: "AND" },
      { id: "deleted", operator: "=", match: "0", gate: "AND" }
    ],
    joins: [], sort: {}, getData: [122, 123, 124, 125, 127], limit: 500, limitOffset: 0
  };
  const url = "/platform/projects/api/form/query?q=" + encodeURIComponent(JSON.stringify(q)) +
    "&x-filterData=recordID,categoryID";
  const road = Object.values(await fetch(url, { credentials: "same-origin", headers: { Accept: "application/json" } }).then(r => r.json()));
  const val = (row, id) => {
    const k = "id" + id;
    for (const b of [row.s1, ...Object.keys(row).filter(x => /^s\d+$/.test(x) && x !== "s1").map(x => row[x]), row]) {
      if (b && b[k] != null && String(b[k]).trim() !== "") return String(b[k]).trim();
    }
    return "";
  };
  console.log("Records with a capability (125):", road.length);
  const byForm = {};
  road.forEach(r => { byForm[r.categoryID] = (byForm[r.categoryID] || 0) + 1; });
  console.log("Forms holding them:", byForm);
  console.table([122, 123, 127].map(id => ({
    indicator: id,
    filled: road.filter(r => val(r, id)).length,
    values: [...new Set(road.map(r => val(r, id)).filter(Boolean))].slice(0, 8).join(" | ")
  })));
  console.log("Description (124) filled:", road.filter(r => val(r, 124)).length);
  console.log("Sample:", road.slice(0, 2).map(r => ({ cap: val(r, 125), theme: val(r, 123), fy: val(r, 122), status: val(r, 127) })));
})();